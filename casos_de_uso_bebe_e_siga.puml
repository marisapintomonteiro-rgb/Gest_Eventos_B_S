@startuml

title Bebe e Siga — Acesso e gestão de utilizadores

left to right direction

skinparam shadowing false
skinparam backgroundColor White
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 65

actor "Visitante" as Visitante
actor "Colaborador" as Colaborador
actor "Gestor" as Gestor
actor "Administrador" as Admin

Colaborador <|-- Gestor
Gestor <|-- Admin

rectangle "Bebe e Siga" {
  usecase "Criar conta\n(UC03)" as Registo
  usecase "Iniciar sessão\n(UC01)" as Login
  usecase "Gerir utilizadores\n(UC02)" as Utilizadores
}

Visitante -- Registo
Colaborador -- Login
Admin -- Utilizadores

note bottom of Utilizadores
  Funcionalidade exclusiva
  do Administrador.
end note

@enduml


@startuml

title Bebe e Siga — Planeamento do evento

left to right direction

skinparam shadowing false
skinparam backgroundColor White
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 65

actor "Gestor" as Gestor
actor "Administrador" as Admin

Gestor <|-- Admin

rectangle "Bebe e Siga" {

  package "Evento" {
    usecase "Criar evento\n(UC04)" as Criar
    usecase "Configurar dias do evento\n(UC05)" as Dias
  }

  package "Produtos e ementa" {
    usecase "Gerir produtos\n(UC07)" as Produtos
    usecase "Gerir ementa\n(UC08)" as Ementa
    usecase "Definir composição\n(UC09)" as Composicao
    usecase "Reutilizar ementa\n(UC10)" as Reutilizar
  }

  package "Fornecimento" {
    usecase "Gerir fornecedores\n(UC11)" as Fornecedores
    usecase "Consultar previsão de compras\n(UC13)" as Previsao
  }
}

Gestor -- Criar
Gestor -- Dias
Gestor -- Produtos
Gestor -- Ementa
Gestor -- Fornecedores
Gestor -- Previsao

Criar ..> Dias : <<include>>

Composicao ..> Ementa : <<extend>>\n[artigo composto]
Reutilizar ..> Ementa : <<extend>>\n[copiar edição anterior]

legend bottom
  Pré-condição: sessão iniciada.
  O Administrador herda as funcionalidades do Gestor.
endlegend

@enduml


@startuml

title Bebe e Siga — Operação diária do evento

left to right direction

skinparam shadowing false
skinparam backgroundColor White
skinparam monochrome true
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 65

actor "Colaborador" as Colaborador
actor "Gestor" as Gestor
actor "Administrador" as Admin

Colaborador <|-- Gestor
Gestor <|-- Admin

rectangle "Bebe e Siga" {

  package "Consulta e registo diário" {
    usecase "Consultar calendário\n(UC06)" as Calendario
    usecase "Consultar ementa\n(UC29)" as Ementa
    usecase "Registar vendas\n(UC14)" as Vendas
    usecase "Registar consumo interno\n(UC16)" as Consumo
    usecase "Consultar faturação diária\n(UC30)" as Faturacao
  }

  package "Controlo do evento" {
    usecase "Registar compras\n(UC12)" as Compras
    usecase "Corrigir stock\n(UC17)" as Stock
    usecase "Encerrar ou reabrir dia\n(UC19)" as Dia
  }
}

Colaborador -- Calendario
Colaborador -- Ementa
Colaborador -- Vendas
Colaborador -- Consumo
Colaborador -- Faturacao

Gestor -- Compras
Gestor -- Stock
Gestor -- Dia

legend bottom
  Pré-condição: sessão iniciada.

  O Gestor herda as funcionalidades do Colaborador.
  O Administrador herda as funcionalidades do Gestor.

  O Colaborador não consulta custos nem lucro.
endlegend

@enduml


